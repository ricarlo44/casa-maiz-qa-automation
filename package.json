{
  "name": "casa-maiz-qa-automation",
  "version": "1.0.0",
  "description": "API/contract tests and Playwright browser tests for the public Payload CMS and the Casa Maiz web consumer.",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",

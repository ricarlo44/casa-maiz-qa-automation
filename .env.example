# Public, read-only Payload CMS and web consumer under test.
# Copy this file to .env and adjust values for a different environment if needed.
# Nothing here is a secret: both targets are public and unauthenticated.

CMS_URL=https://payload-cms-poc-seven.vercel.app
WEBSITE_URL=https://payload-website-consumer.vercel.app

# Delivery context sent on every content request (see OpenAPI: platform/market/audience/appVersion).
CMS_MARKET=MX
CMS_AUDIENCE=guest
CMS_APP_VERSION=2.4.0
